{
	"name": "obsidian-divide-and-conquer",
	"version": "2.2.0",
	"description": "An Obsidian plugin that provides commands for bulk enabling/disabling of plugins. Intended for power users with many plugins.",
	"main": "dist/main.js",
	"scripts": {
		"dev": "npm run copy-over && npm run build -- watch",
		"build": "node .esbuild.mjs",
		"build:production": "npm run copy-over && npm run build -- production",
		"build:analyze": "npm run copy-over && npm run build -- analyze",
		"copy-over": "shx mkdir -p dist && shx cp manifest.json styles.css dist/",
		"release:notes": "node generate-release-notes.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"pretest:e2e": "npm run build:production",
		"test:e2e": "wdio run ./wdio.conf.mts",
		"test:e2e:headless": "node scripts/run-headless.mjs test:e2e",
		"test:e2e:verify": "node scripts/verify-version-coverage.mjs",
		"test:e2e:verify:headless": "node scripts/run-headless.mjs test:e2e:verify",
		"coverage": "vitest run --coverage",
		"lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
		"lint:eslint": "eslint \"src/**/*.ts\"",
		"lint": "npm run lint:md && npm run lint:eslint",
		"lint:fix": "npm run lint:md -- --fix && npm run lint:eslint -- --fix"
	},
	"keywords": [],
	"author": "Mike DiDomizio",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@eslint/js": "^9.23.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.5.5",
		"@vitest/coverage-v8": "^4.1.0",
		"@wdio/cli": "^9.31.2",
		"@wdio/globals": "^9.31.1",
		"@wdio/local-runner": "^9.31.2",
		"@wdio/mocha-framework": "^9.31.2",
		"chokidar": "^5.0.0",
		"esbuild": "^0.27.7",
		"eslint": "^9.23.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^16.0.0",
		"happy-dom": "^20.8.4",
		"knip": "latest",
		"markdownlint-cli": "latest",
		"mocha": "^11.8.0",
		"obsidian": "latest",
		"shx": "^0.4.0",
		"tslib": "2.7.0",
		"typescript": "^5.6.2",
		"typescript-eslint": "^8.27.0",
		"vitest": "^4.1.0",
		"wdio-obsidian-reporter": "^3.2.0",
		"wdio-obsidian-service": "^3.2.0",
		"webdriverio": "^9.31.2"
	},
	"dependencies": {
		"@types/tinycolor": "^1.1.27",
		"monkey-around": "^3.0.0",
		"tinycolor2": "^1.4.2",
		"typescript-super-set": "^1.0.0"
	},
	"engines": {
		"node": ">=24.14.1"
	}
}
